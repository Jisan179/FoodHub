# Copy this file to .env and adjust it. Never commit .env.
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/FoodHub
APP_TIMEZONE=Asia/Dhaka

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foodhub_v3
DB_USER=root
DB_PASS=

# "log" writes emails to storage/logs/mail.log. "mail" uses PHP's mail() function.
MAIL_DRIVER=log
MAIL_FROM=no-reply@foodhub.test
