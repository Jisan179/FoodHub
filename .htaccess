# Only the public/ folder is reachable. Every request is routed into it, so
# source code, .env, .git and database files can never be downloaded.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fail closed if URL rewriting is unavailable
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
